{
  "realm": "clearsettle",
  "enabled": true,
  "sslRequired": "external",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "registrationAllowed": false,
  "attributes": {
    "acr.loa.map": "{\"pwd\":1,\"mfa\":2}"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10
    }
  ],
  "browserFlow": "clearsettle-browser",
  "authenticationFlows": [
    {
      "alias": "clearsettle-browser",
      "description": "Level-of-authentication browser flow: level 1 = password, level 2 = OTP.",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "clearsettle-forms",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "clearsettle-forms",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "clearsettle-loa1",
          "requirement": "CONDITIONAL",
          "priority": 10,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "clearsettle-loa2",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "authenticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "clearsettle-loa1",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "cs-loa1",
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "cs-ref-pwd"
        }
      ]
    },
    {
      "alias": "clearsettle-loa2",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticatorConfig": "cs-loa2",
          "authenticator": "conditional-level-of-authentication",
          "requirement": "REQUIRED",
          "priority": 10,
          "authenticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "authenticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "cs-ref-otp"
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "cs-loa1",
      "config": {
        "loa-condition-level": "1",
        "loa-max-age": "36000"
      }
    },
    {
      "alias": "cs-loa2",
      "config": {
        "loa-condition-level": "2",
        "loa-max-age": "0"
      }
    },
    {
      "alias": "cs-ref-pwd",
      "config": {
        "default.reference.value": "pwd"
      }
    },
    {
      "alias": "cs-ref-otp",
      "config": {
        "default.reference.value": "otp"
      }
    }
  ],
  "clients": [
    {
      "clientId": "clearsettle-web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${CS_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:8443/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost:8443/",
        "backchannel.logout.session.required": "true",
        "default.acr.values": "mfa",
        "minimum.acr.value": "mfa"
      },
      "protocolMappers": [
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "false",
            "lightweight.claim": "false"
          }
        }
      ]
    }
  ]
}
