# ClearSettle local development environment (example). Copy to deploy/.env and fill in LOCAL-ONLY,
# NON-PRODUCTION values. Never commit deploy/.env. These are development secrets for the local stack
# only; production secrets come from the deployment's secret manager, never from source control.
#
# Generate strong random values locally, e.g.:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me-local-only
APP_DB_PASSWORD=change-me-local-only
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KC_CLIENT_SECRET=change-me-local-only
# Encrypts the __Host-CSLOGIN login-state cookie (D-SEC-15). Use a strong random value.
LOGIN_STATE_SECRET=change-me-local-only
