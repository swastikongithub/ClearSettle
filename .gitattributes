# Files consumed inside Linux containers (shell scripts, proxy/DB/IdP config, compose, SQL) must keep LF
# line endings regardless of the developer's core.autocrlf setting; CRLF breaks e.g. init.sh in Postgres.
* text=auto
*.sh        text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.properties text eol=lf
Dockerfile  text eol=lf
.env.example text eol=lf
