# Build output
backend/target/
**/target/
*.class

# Node / frontend
node_modules/
frontend/.next/
frontend/out/

# Secrets and local environment — never commit real secrets (D-PRC-04, NFR-SEC-025)
.env
*.env
!*.env.example
deploy/.env
# Raw e2e run output (sanitized summaries are recorded in docs/product/clearsettle_implementation_status.md)
e2e/results/

# Locally generated dev TLS material (private keys must never be committed)
deploy/nginx/certs/
*.key
*.pem

# Local tooling
.idea/
*.iml
.vscode/
*.log
